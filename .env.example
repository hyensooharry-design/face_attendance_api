# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key

# Face recognition
# 0 = real ArcFace model, 1 = deterministic test embeddings
DUMMY_MODE=0
FACE_DEVICE=cpu
MODELS_DIR=models/ai
AUTO_DOWNLOAD_MODELS=1

# Optional model override
ARC_MODEL_URL=https://github.com/hyensooharry-design/face_attendance_api/releases/download/models-v1/arcface.onnx
ARC_MODEL_SHA256=f3a6bc281e72f88862f5748b53be3d76b3b48f8f1ab1f4a537941bdc4e1b01da

# Optional legacy RetinaFace asset download (not required by current inference path)
DOWNLOAD_RETINAFACE=0
RETINA_MODEL_URL=https://github.com/hyensooharry-design/face_attendance_api/releases/download/models-v1/retinaface.onnx
RETINA_MODEL_SHA256=40f825cf7dd0a88b26fb61db9a3aaedc2cad35162091113f4017b3c26a4f792d

# API/UI
API_BASE=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
DEBUG_ERRORS=0
SCAN_INTERVAL_SEC=1.5
AUTO_REFRESH_MS=500
